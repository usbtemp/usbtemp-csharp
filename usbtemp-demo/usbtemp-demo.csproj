<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET Framework 4.0 only, so the demo builds in Visual Studio 2017. -->
    <TargetFramework>net40</TargetFramework>
    <!-- C# 7.0 is the default of Visual Studio 2017; newer syntax would not compile there. -->
    <LangVersion>7.0</LangVersion>
    <RootNamespace>demo</RootNamespace>
    <AssemblyName>usbtemp-demo</AssemblyName>

    <Version>1.0.0</Version>
    <AssemblyTitle>usbtemp-demo</AssemblyTitle>
    <Product>usbtemp-demo</Product>
    <Copyright>Copyright © 2018</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\usbtemp\usbtemp.csproj" />
  </ItemGroup>

</Project>
