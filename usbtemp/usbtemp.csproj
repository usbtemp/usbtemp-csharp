<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net40 keeps the original .NET Framework 4.0 support; netstandard2.0 covers
         .NET Framework 4.6.1+, .NET Core and .NET 5 and later on Windows, Linux and macOS. -->
    <TargetFrameworks>net40;netstandard2.0</TargetFrameworks>
    <!-- C# 7.0 is the default of Visual Studio 2017; newer syntax would not compile there. -->
    <LangVersion>7.0</LangVersion>
    <RootNamespace>usbtemp</RootNamespace>
    <AssemblyName>usbtemp</AssemblyName>

    <Version>1.0.0</Version>
    <AssemblyTitle>usbtemp</AssemblyTitle>
    <Product>usbtemp</Product>
    <Description>Reads the usbtemp.com USB thermometer (DS18B20 on a DS9097E compatible 1-wire adapter).</Description>
    <Copyright>Copyright © 2018</Copyright>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- SerialPort is part of .NET Framework, but a separate package everywhere else. -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <!-- Lets "dotnet build" compile the net40 target without .NET Framework installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
